#include <stdio.h>

 void print_back(int arr[],int size,int index){
  if(index < 0){
   return ;
}
  printf(" %d",arr[index]);
  return print_back(arr,size, index - 1);
  


 int main(){
  int size = 0;
  printf("Enter the size of Array");
  scanf("%d",&size);
  int arr[size];
  printf("Enter the values of array");
  for(int i  = 0; i < size ; ++i){
   scanf("%d",&arr[i]);
  }
  printf("Array Elements:\n");
  print_back(arr, size, size - 1);
  return 0;
 }
