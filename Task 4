#include <stdio.h>

  void print(int arr[], int size,int index){
    if(index >= size){
     return;
   }
      printf(" %d",arr[index]);
   return print(arr, size , index + 1);
}


   int main(){
    int num = 0;
    printf("Enter size of Arr");
    scanf("%d",&num);
    int arr[num];
    printf("Enter the numbers");
    for(int i = 0; i < num ;++i){
     scanf("%d",&arr[i]);
    }
    printf("Array Elements:\n");
    print(arr,num,0);
    return 0;
   }
